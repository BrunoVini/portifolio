---
import { getProfile } from '../../lib/profile';
import en from '../../i18n/en.json';
import pt from '../../i18n/pt.json';
import { t } from '../../lib/i18n';
import ProjectPolaroid from './ProjectPolaroid.astro';
import ProjectsDecorations from './ProjectsDecorations.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import BugMargin from '../ui/BugMargin.astro';
import type { Locale } from '../../lib/types';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = getProfile(locale);
const table = { en, pt };
const aside = locale === 'pt' ? '* já entregues 🚀' : '* shipped & alive 🚀';
---

<div class="wrap" id="work">
  <ProjectsDecorations />
  <BugMargin
    locale={locale}
    en="meta-bug: this site is the second project."
    pt="bug-meta: este site é o segundo projeto."
    position="bottom"
    side="right"
  />
  <SectionTitle
    title={t('projects.headline', locale, table)}
    chapter="PG. 51"
    icon="work"
    aside={aside}
  />
  <div class="grid">
    {
      p.projects.map((proj, i) => (
        <ProjectPolaroid
          id={proj.id}
          title={proj.title}
          tagline={proj.tagline}
          description={proj.description}
          stack={proj.stack}
          href={proj.links.demo ?? proj.links.repo}
          featured={proj.featured}
          panel={String(i + 1).padStart(2, '0')}
          tradeOffs={proj.tradeOffs}
          locale={locale}
        />
      ))
    }
  </div>
</div>

<style>
  .wrap {
    padding: 80px 130px;
    position: relative;
    display: block;
  }
  /* SectionTitle component handles section heading styling */
  .grid {
    display: grid;
    /* Three projects share the row on wide screens so it fills the page instead
       of leaving a lone card stranded on a second row. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    position: relative;
    z-index: 2;
  }
  @media (max-width: 1100px) {
    .wrap {
      padding: 60px 56px;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px;
    }
  }
  @media (max-width: 600px) {
    .wrap {
      /* extra bottom room so the meta-bug note can tuck into the corner BELOW
         the last card's "see trade-offs" flip button (which hangs off the
         bottom-right on a single column) */
      padding: 28px 12px 56px 22px;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .wrap :global(.bug-margin.side-right) {
      bottom: 8px;
    }
  }
</style>
