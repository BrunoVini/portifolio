---
import './ProjectPolaroid.css';
import './ProjectPolaroidFlip.css';
import ProjectThumb from './ProjectThumb.astro';
import en from '../../i18n/en.json';
import pt from '../../i18n/pt.json';
import { t } from '../../lib/i18n';
import type { Locale } from '../../lib/types';
interface Props {
  id?: string;
  title: string;
  tagline: string;
  description: string;
  stack: string[];
  href?: string;
  featured?: boolean;
  panel?: string;
  tradeOffs?: string[];
  locale?: Locale;
}
const {
  id,
  title,
  tagline,
  description,
  stack,
  href,
  featured = false,
  panel,
  tradeOffs,
  locale = 'en',
} = Astro.props;
const table = { en, pt };
const flipLabel = t('projects.flipLabel', locale, table);
const backTitle = t('projects.backTitle', locale, table);
const backFoot = t('projects.backFoot', locale, table);
const sketchLabel = t('projects.sketchCaption', locale, table);
const Tag = href ? 'a' : 'article';
const linkAttrs = href ? { href, target: '_blank', rel: 'noopener noreferrer' } : {};
const hasFlip = (tradeOffs?.length ?? 0) > 0;
/* The surviving code motif: one tiny mono line on a torn strip, per project. */
const codeSnippets: Record<string, string> = {
  darksense: '$ darksense --watch',
  'this-portfolio': '$ astro build && deploy',
  atelier: '$ atelier scan ./repo',
};
const codeLine = (id && codeSnippets[id]) ?? '$ make ship';
---

<div class={`proj-shell ${hasFlip ? 'has-flip' : ''}`} data-reveal="settle">
  <Tag
    class={`proj ${featured ? 'is-featured' : ''}`}
    {...hasFlip ? {} : { 'data-tilt': true }}
    {...linkAttrs}
  >
    <span class="tape tilt-layer" data-depth="1.4" aria-hidden="true"></span>
    {
      panel && (
        <span class="panel-label tilt-layer" data-depth="0.8" aria-hidden="true">
          FIG {panel}
        </span>
      )
    }
    {
      featured && (
        <span class="featured-stamp tilt-layer" data-depth="1.6" aria-hidden="true">
          <span>SHIPPED</span>
        </span>
      )
    }
    <div class="sketch">
      <ProjectThumb id={id} title={title} />
      <span class="sketch-cap" aria-hidden="true">
        {sketchLabel}
      </span>
    </div>
    <div class="meta">
      <h3>
        <span class="title-hl">{title}</span>
      </h3>
      <p class="tag">{tagline}</p>
      <p class="desc">{description}</p>
      <span class="code-strip" aria-hidden="true">
        {codeLine}
      </span>
      {
        stack.length > 0 && (
          <ul class="stack" aria-label="Stack">
            {stack.map((s) => (
              <li class={/test/i.test(s) ? 'is-tests' : ''}>{s}</li>
            ))}
          </ul>
        )
      }
    </div>
  </Tag>
  {
    hasFlip && tradeOffs && (
      <button class="flip-btn" type="button" aria-pressed="false" aria-label={flipLabel}>
        <span class="flip-icon" aria-hidden="true">
          ↺
        </span>
        <span class="flip-label">{flipLabel}</span>
      </button>
    )
  }
  {
    hasFlip && tradeOffs && (
      <aside class="proj-back" aria-hidden="true">
        <h4>{backTitle}</h4>
        <ol>
          {tradeOffs.map((t) => (
            <li>{t}</li>
          ))}
        </ol>
        <p class="back-foot">{backFoot}</p>
      </aside>
    )
  }
</div>
