---
import CategoryIcon from './CategoryIcon.astro';
import SkillIcon from './SkillIcon.astro';
interface Props {
  category: string;
  items: { name: string; note?: string; featured?: boolean }[];
}
const { category, items } = Astro.props;
---

<section class="grp" data-reveal="settle">
  {
    /* Hand-drawn lasso enclosing the cluster — badges read as a grouped set,
      not loose soup. Inks itself in via the shared data-ink primitive. */
  }
  <svg
    class="grp-lasso"
    viewBox="0 0 300 160"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    data-ink="enter"
  >
    <path
      d="M 14 22 Q 8 8, 30 8 L 250 6 Q 294 4, 292 30 L 294 132 Q 296 154, 264 152 L 36 154 Q 6 156, 8 130 L 6 30 Q 6 24, 14 22 Z"
      fill="none"
      stroke="var(--color-pencil-margin)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <header class="grp-head">
    <CategoryIcon name={category} />
    <h3>{category}</h3>
  </header>
  <ul>
    {
      items.map((it, i) => (
        <li>
          <span class={`badge i-${i % 5} ${it.featured ? 'featured' : ''}`}>
            <SkillIcon name={it.name} />
            <span class="badge-text">{it.name}</span>
            {it.note && <span class="note"> — {it.note}</span>}
          </span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .grp {
    position: relative;
    margin-bottom: 36px;
    padding: 18px 18px 16px;
  }
  /* the drawn enclosure fills the cluster box behind its contents */
  .grp-lasso {
    position: absolute;
    inset: -2px -6px;
    width: calc(100% + 12px);
    height: calc(100% + 4px);
    z-index: 0;
    pointer-events: none;
    overflow: visible;
  }
  .grp-head {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: -30px 0 14px;
    padding: 2px 12px 2px 8px;
    /* category sits on a little "label tab" clipped onto the lasso */
    background: var(--color-paper);
    border: 2px solid var(--color-ink);
    border-radius: 6px 12px 8px 14px / 12px 8px 14px 6px;
    box-shadow: 2px 2px 0 var(--color-red-ink);
    transform: rotate(-1.2deg);
  }
  h3 {
    font-family: var(--font-display);
    font-size: 26px;
    color: var(--color-ink);
    margin: 0;
    line-height: 1;
  }
  ul {
    position: relative;
    z-index: 1;
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
  }
  ul > li {
    display: inline-flex;
    transform-origin: center;
  }

  /* pills stamp in one after another as the group scrolls in (the li pops so
     each badge keeps its own hand-drawn tilt) */
  .grp.is-revealed ul > li {
    animation: badge-in 0.42s var(--ease-soft) both;
  }
  .grp.is-revealed ul > li:nth-child(2) {
    animation-delay: 0.07s;
  }
  .grp.is-revealed ul > li:nth-child(3) {
    animation-delay: 0.14s;
  }
  .grp.is-revealed ul > li:nth-child(4) {
    animation-delay: 0.21s;
  }
  .grp.is-revealed ul > li:nth-child(5) {
    animation-delay: 0.28s;
  }
  .grp.is-revealed ul > li:nth-child(6) {
    animation-delay: 0.35s;
  }
  .grp.is-revealed ul > li:nth-child(n + 7) {
    animation-delay: 0.42s;
  }
  @keyframes badge-in {
    0% {
      opacity: 0;
      transform: scale(0.55);
    }

    60% {
      opacity: 1;
      transform: scale(1.08);
    }

    100% {
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .grp.is-revealed ul > li {
      animation: none;
    }
  }
  .badge {
    font-family: var(--font-utility);
    font-size: 16px;
    padding: 8px 14px 8px 10px;
    background: var(--color-paper);
    color: var(--color-ink);
    border: 1.5px solid var(--color-ink);
    border-radius: 14px 18px 16px 20px / 22px 16px 24px 18px;
    transform-origin: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: default;
    transition:
      transform 0.18s var(--ease-soft),
      box-shadow 0.18s ease,
      background 0.18s ease;
  }
  .badge:hover {
    transform: rotate(0) scale(1.06) translateY(-2px);
    box-shadow: 2px 2px 0 var(--color-ink);
    background: var(--color-highlight-soft);
    z-index: 2;
  }
  .badge.featured:hover {
    box-shadow: 3px 3px 0 var(--color-red-ink);
  }
  .badge-text {
    line-height: 1;
  }
  .badge.i-0 {
    transform: rotate(-1.5deg);
  }
  .badge.i-1 {
    transform: rotate(1.2deg);
  }
  .badge.i-2 {
    transform: rotate(-0.6deg);
  }
  .badge.featured {
    background: var(--color-highlight-soft);
    border-color: var(--color-ink);
    border-width: 2px;
    box-shadow: 2px 2px 0 var(--color-ink);
  }
  .badge.i-3 {
    transform: rotate(2deg);
  }
  .badge.i-4 {
    transform: rotate(-2deg);
  }
  .note {
    color: var(--color-ink-soft);
    font-size: 14px;
  }
</style>
