---
// Hand-drawn Vitruvian-style figure. Strokes self-draw via the shared ink
// primitive (src/lib/ink-draw.ts): `data-ink` + auto-stagger replaces the old
// hand-tuned dasharray/delay CSS, with exact lengths measured at runtime.
---

<svg
  class="vitruvian"
  data-ink="enter"
  data-ink-delay="400"
  data-ink-stagger="200"
  viewBox="0 0 280 280"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <filter id="vitruvian-rough">
      <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="3"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="2.4"></feDisplacementMap>
    </filter>
  </defs>
  <g
    filter="url(#vitruvian-rough)"
    stroke="currentColor"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="140" cy="140" r="120" stroke-width="1.4"></circle>
    <rect x="20" y="20" width="240" height="240" stroke-width="1"></rect>
    <circle cx="140" cy="58" r="20" stroke-width="1.6"></circle>
    <path d="M 140 78 L 140 170" stroke-width="1.8"></path>
    <path
      d="M 140 104 L 58 110 M 140 104 L 222 110 M 140 104 L 80 56 M 140 104 L 200 56"
      stroke-width="1.7"></path>
    <path
      d="M 140 170 L 120 250 M 140 170 L 160 250 M 140 170 L 80 224 M 140 170 L 200 224"
      stroke-width="1.7"></path>
    <path
      d="M 54 107 L 62 113 M 218 107 L 226 113 M 76 52 L 84 60 M 196 52 L 204 60"
      stroke-width="1.6"></path>
    <circle cx="140" cy="140" r="2.6" fill="currentColor" stroke="none"></circle>
  </g>
</svg>

<style>
  .vitruvian {
    position: absolute;
    right: 7%;
    top: 8%;
    width: 280px;
    height: 280px;
    z-index: 4;
    opacity: 0.65;
    color: var(--color-ink);
  }
  @media (max-width: 979px) and (min-width: 601px) {
    .vitruvian {
      width: 200px;
      height: 200px;
      right: 4%;
      top: 10%;
      opacity: 0.55;
    }
  }
  @media (max-width: 600px) {
    .vitruvian {
      display: none;
    }
  }
</style>
