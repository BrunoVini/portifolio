---
import { getProfile } from '../../lib/profile';
import en from '../../i18n/en.json';
import pt from '../../i18n/pt.json';
import { t } from '../../lib/i18n';
import Button from '../ui/Button.astro';
import HeroHeadline from './HeroHeadline.astro';
import VitruvianFigure from './VitruvianFigure.astro';
import Gear from './Gear.astro';
import StickyNote from './StickyNote.astro';
import Polaroid from './Polaroid.astro';
import CoffeeRing from './CoffeeRing.astro';
import Tape from './Tape.astro';
import Signature from './Signature.astro';
import SoundEffect from '../ui/SoundEffect.astro';
import HeroComicStrip from './HeroComicStrip.astro';
import HeroMobileStickies from './HeroMobileStickies.astro';
import './Hero.css';
import type { Locale } from '../../lib/types';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = getProfile(locale);
const table = { en, pt };
const dateFmt = locale === 'pt' ? 'pt-BR' : 'en-US';
const today = new Date().toLocaleDateString(dateFmt, { dateStyle: 'long' });
---

<Tape position="tl" />
<Tape position="tr" />
<Tape position="br" />
<div class="date">{today}</div>

<VitruvianFigure />
<Gear />
<Polaroid caption="DarkSense ✦ 2025" />
<StickyNote
  text={p.hero.currentlyNote}
  cycle={p.hero.currentlyCycle ?? []}
  label={locale === 'pt' ? 'agora:' : 'currently:'}
/>
<CoffeeRing />

<div class="content">
  <p class="eyebrow">{p.hero.eyebrow}</p>
  <!-- Real copy for SR/SEO; the SVG hand-letters the same words. -->
  <h1 class="sr-only">{p.hero.titleLine1} {p.hero.titleLine2}</h1>
  <div class="headline" aria-hidden="true">
    <HeroHeadline lead={p.hero.titleLine1} focus={p.hero.titleLine2} id={locale} />
    <span class="shipped-note">{p.hero.titleAccent}</span>
  </div>
  <p class="sub">{p.hero.subtitle}</p>
  <div class="ctas">
    <Button variant="primary" href="#work">{p.hero.primaryCTA} →</Button>
    <Button href="#contact">{p.hero.secondaryCTA}</Button>
  </div>
</div>

<div class="diary-sticker" data-depth="3" aria-hidden="true">
  <span class="ds-of"
    >{locale === 'pt' ? 'O ' : 'THE '}<span data-journal
      >{locale === 'pt' ? 'DIÁRIO' : 'DIARY'}</span
    >{locale === 'pt' ? ' DE' : ' OF'}</span
  >
  <strong class="ds-name">Bruno Vinicius</strong>
  <span class="ds-vol">VOL. 1</span>
</div>

<div class="sfx-1" data-depth="1">
  <SoundEffect text="ZAP!" color="highlight" rotate={-12} size={84} />
</div>
<div class="sfx-3"><SoundEffect text="SHIP!" color="highlight" rotate={-6} size={80} /></div>

<HeroComicStrip locale={locale} />
<HeroMobileStickies locale={locale} />
<Signature />

<!-- Scroll hint that pays off: a red pen arrow inks itself toward the gutter,
     where the margin thread takes over and runs down the whole page. -->
<div class="scroll-hint">
  <svg
    class="thread-start"
    data-ink="enter"
    data-ink-delay="2300"
    data-ink-stagger="180"
    viewBox="0 0 34 58"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <g fill="none" stroke="var(--color-red-ink)" stroke-width="2" stroke-linecap="round">
      <path d="M 26 4 C 30 14, 24 22, 17 30 C 11 37, 12 45, 14 51"></path>
      <path d="M 8 45 C 10 48, 12 50, 14 51.5 C 16.5 49.5, 19 46.5, 20 43.5"></path>
    </g>
  </svg>
  <div class="hint-col">
    <span class="hint-thread">{t('hero.threadStart', locale, table)}</span>
    <span class="hint-label">{t('hero.scrollHint', locale, table)}</span>
  </div>
</div>

<script>
  import { initHeroParallax } from '../../lib/hero-parallax';
  initHeroParallax();
</script>
