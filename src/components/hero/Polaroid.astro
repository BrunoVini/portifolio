---
interface Props {
  caption: string;
}
const { caption } = Astro.props;
---

<div class="polaroid" data-depth="2">
  <div class="polaroid-img">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="100" height="100" fill="var(--color-ink)"></rect>
      <!-- DarkSense as a tiny SOC radar scope: a snapshot of the product watching. -->
      <g class="radar-rings" stroke="var(--color-code-green)" fill="none" stroke-width="0.8">
        <circle cx="50" cy="46" r="12" opacity="0.35"></circle>
        <circle cx="50" cy="46" r="24" opacity="0.25"></circle>
        <circle cx="50" cy="46" r="34" opacity="0.18"></circle>
        <line x1="16" y1="46" x2="84" y2="46" opacity="0.18"></line>
        <line x1="50" y1="12" x2="50" y2="80" opacity="0.18"></line>
      </g>
      <g class="radar-sweep">
        <polygon points="50,46 50,12 70,18" fill="var(--color-code-green)" opacity="0.22"></polygon>
        <line
          x1="50"
          y1="46"
          x2="50"
          y2="12"
          stroke="var(--color-code-green)"
          stroke-width="1"
          opacity="0.7"></line>
      </g>
      <!-- blips: clear contacts (green) + one flagged threat (red, pulsing) -->
      <circle cx="64" cy="34" r="1.8" fill="var(--color-code-green-light)"></circle>
      <circle cx="38" cy="58" r="1.6" fill="var(--color-code-green-light)" opacity="0.8"></circle>
      <circle class="radar-threat" cx="34" cy="36" r="2.2" fill="var(--color-term-alert)"></circle>
      <text
        x="14"
        y="22"
        font-family="JetBrains Mono"
        font-size="7"
        fill="var(--color-code-green)"
        opacity="0.85">$ watch</text
      >
      <text
        x="50"
        y="92"
        text-anchor="middle"
        font-family="JetBrains Mono"
        font-size="7"
        fill="var(--color-code-green)"
        opacity="0.7">● secure</text
      >
    </svg>
  </div>
  <div class="polaroid-caption">{caption}</div>
</div>

<style>
  .polaroid {
    position: absolute;
    right: 21%;
    top: 31%;
    width: 150px;
    background: var(--color-paper);
    padding: 8px 8px 22px;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.18);
    transform: rotate(5deg);
    z-index: 6;
    opacity: 0;
    animation: stickyIn 0.5s var(--ease-ink) 1.5s forwards;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }
  @media (prefers-reduced-motion: reduce) {
    .polaroid {
      animation-delay: 0s;
    }
  }
  .polaroid-img {
    aspect-ratio: 1;
    background: var(--color-ink);
    position: relative;
    overflow: hidden;
  }
  .polaroid-img svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* radar sweep rotates around the scope centre; the threat blip pulses.
     Both are ambient — the global prefers-reduced-motion rule freezes them. */
  .radar-sweep {
    transform-origin: 50px 46px;
    animation: radar-spin 4s linear infinite;
  }
  @keyframes radar-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .radar-threat {
    transform-box: fill-box;
    transform-origin: center;
    animation: radar-blip 1.4s ease-in-out infinite;
  }
  @keyframes radar-blip {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }
  .polaroid-caption {
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--color-ink);
    text-align: center;
    margin-top: 6px;
  }
  @media (max-width: 979px) and (min-width: 601px) {
    .polaroid {
      width: 116px;
      right: 7%;
      top: 32%;
    }
  }
  @media (max-width: 600px) {
    .polaroid {
      display: none;
    }
  }
</style>
