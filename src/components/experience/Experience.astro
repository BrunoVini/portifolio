---
import { getProfile } from '../../lib/profile';
import en from '../../i18n/en.json';
import pt from '../../i18n/pt.json';
import { t } from '../../lib/i18n';
import TimelineNode from './TimelineNode.astro';
import ExperienceDecorations from './ExperienceDecorations.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import BugMargin from '../ui/BugMargin.astro';
import type { Locale } from '../../lib/types';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = getProfile(locale);
const table = { en, pt };
const aside = locale === 'pt' ? '* a história até aqui' : '* the story so far';
const toggleHint = locale === 'pt' ? 'clique pra abrir →' : 'click to open →';
---

<div class="exp" id="experience">
  <ExperienceDecorations />
  <BugMargin
    locale={locale}
    en="I live here now."
    pt="moro aqui agora."
    position="bottom"
    side="right"
  />
  <SectionTitle
    title={t('experience.headline', locale, table)}
    chapter="PG. 50"
    icon="experience"
    aside={aside}
  />
  <svg
    class="timeline-ink"
    viewBox="0 0 12 1000"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    data-ink="scroll"
  >
    <path
      d="M6 2 C9 70, 3 130, 6 200 C9 270, 3 330, 6 400 C9 470, 3 530, 6 600 C9 670, 3 730, 6 800 C9 870, 4 930, 6 998"
      fill="none"
      stroke="var(--color-ink)"
      stroke-width="2.4"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"></path>
  </svg>
  <div class="nodes">
    {
      p.experience.map((e, i) => (
        <TimelineNode
          company={e.company}
          companyLogo={e.companyLogo}
          location={e.location}
          employmentType={e.employmentType}
          role={e.role}
          startDate={e.startDate}
          endDate={e.endDate === 'present' ? t('common.present', locale, table) : e.endDate}
          description={e.description}
          highlights={e.highlights}
          stats={e.stats}
          current={e.endDate === 'present'}
          kind={e.kind}
          schoolLabel={locale === 'pt' ? 'BOLETIM' : 'SCHOOL RECORDS'}
          defaultOpen={e.endDate === 'present'}
          index={i}
          toggleHint={toggleHint}
        />
      ))
    }
  </div>
</div>

<style>
  .exp {
    padding: 56px 130px 12px;
    position: relative;
  }
  /* SectionTitle component handles section heading styling */
  /* The career line: one continuous hand-drawn stroke that inks itself in as
     you scroll the section (data-ink="scroll"). It runs down the left margin,
     threading the node logos; entries settle onto it like pinned notes. */
  .timeline-ink {
    position: absolute;
    left: 157px;
    top: 188px;
    bottom: 40px;
    width: 14px;
    z-index: 1;
    color: var(--color-ink);
    opacity: 0.32;
    pointer-events: none;
    overflow: visible;
  }
  .nodes {
    position: relative;
    z-index: 2;
  }
  @media (max-width: 1100px) {
    .exp {
      padding: 48px 56px 12px;
    }
  }
  @media (max-width: 600px) {
    .exp {
      padding: 32px 18px 32px 32px;
    }
    .timeline-ink {
      left: 53px;
      top: 148px;
    }
    .nodes {
      padding-top: 24px;
    }
  }
</style>
