---
import Sketch from './art/Sketch.astro';
import Tdd from './art/Tdd.astro';
import Build from './art/Build.astro';
import Ship from './art/Ship.astro';

interface Props {
  step: string;
  inkOrder?: number;
}
const { step, inkOrder = 0 } = Astro.props;

// Comic-page pacing: each panel's art starts inking after the previous one,
// so the strip reads left-to-right like reading a comic strip. The strokes
// inside a panel auto-stagger; the per-panel base delay sequences the panels.
const inkDelay = 240 + inkOrder * 420;
---

{step === 'sketch' && <Sketch inkDelay={inkDelay} />}
{step === 'tdd' && <Tdd inkDelay={inkDelay} />}
{step === 'build' && <Build inkDelay={inkDelay} />}
{step === 'ship' && <Ship inkDelay={inkDelay} />}
