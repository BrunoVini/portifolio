---
import en from '../../i18n/en.json';
import pt from '../../i18n/pt.json';
import { t } from '../../lib/i18n';
import './ProcessTools.css';
import type { Locale } from '../../lib/types';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const table = { en, pt };

const rots = ['-1.2deg', '0.8deg', '-0.5deg', '1deg', '-0.7deg'];
const source = locale === 'pt' ? pt : en;
const tools = source.process.tools.map((tool, i) => ({ ...tool, rot: rots[i] ?? '0deg' }));

const header = t('process.toolsHeader', locale, table);
---

<div class="tools">
  <p class="tools-header">{header}</p>
  <div class="tools-grid">
    {
      tools.map((toolItem) => (
        <div class="tool-card" data-reveal style={`--rot:${toolItem.rot}`}>
          <strong class="tool-name">{toolItem.name}</strong>
          <span class="tool-caption">{toolItem.caption}</span>
        </div>
      ))
    }
  </div>
</div>
