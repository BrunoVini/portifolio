---
interface Props {
  inkDelay?: number;
}
const { inkDelay = 0 } = Astro.props;
---

<svg
  viewBox="0 0 100 100"
  xmlns="http://www.w3.org/2000/svg"
  data-ink="enter"
  data-ink-stagger="70"
  data-ink-delay={inkDelay}
>
  <g
    stroke="var(--color-ink)"
    fill="none"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {/* test tube */}
    <clipPath id="tdd-tube-clip">
      <path d="M 30 22 L 30 74 Q 30 90, 42 90 Q 54 90, 54 74 L 54 22 Z"></path>
    </clipPath>
    <g clip-path="url(#tdd-tube-clip)">
      <rect
        class="tdd-liquid"
        x="28"
        y="54"
        width="28"
        height="40"
        fill="var(--color-red-ink)"
        fill-opacity="0.6"
        stroke="none"></rect>
    </g>
    <path d="M 30 22 L 30 74 Q 30 90, 42 90 Q 54 90, 54 74 L 54 22"></path>
    <line x1="26" y1="20" x2="58" y2="20" stroke-width="3"></line>

    {/* bubbles rising through the liquid */}
    <circle class="tdd-bubble tdd-b1" cx="40" cy="78" r="2.4" fill="var(--color-paper)"></circle>
    <circle class="tdd-bubble tdd-b2" cx="47" cy="72" r="1.7" fill="var(--color-paper)"></circle>

    {/* red → green: the fail mark gives way to the pass mark */}
    <g class="tdd-fail">
      <path d="M 70 32 L 80 42 M 80 32 L 70 42" stroke="var(--color-red-ink)" stroke-width="2.6"
      ></path>
    </g>
    <path
      class="tdd-arrow"
      d="M 75 48 L 75 56 M 71 52 L 75 56 L 79 52"
      stroke="var(--color-ink)"
      stroke-width="1.8"
      opacity="0.45"></path>
    <g class="tdd-pass">
      <path d="M 69 64 L 74 70 L 82 60" stroke="var(--color-code-green)" stroke-width="3"></path>
    </g>
  </g>
</svg>
