<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
  <g
    stroke="var(--color-ink)"
    fill="none"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {/* idea spark */}
    <g class="sk-idea" stroke="var(--color-highlight-strong)" stroke-width="2.2">
      <line x1="50" y1="16" x2="50" y2="9"></line>
      <line x1="40" y1="20" x2="35" y2="15"></line>
      <line x1="60" y1="20" x2="65" y2="15"></line>
    </g>

    {/* sketch pad / canvas */}
    <rect x="16" y="28" width="50" height="56" rx="4" fill="var(--color-paper)"></rect>

    {/* wireframe being roughed out */}
    <line class="sk-line sk-line-1" x1="24" y1="40" x2="58" y2="40" stroke-width="1.6"></line>
    <circle class="sk-line sk-line-2" cx="30" cy="54" r="5" stroke-width="1.6"></circle>
    <line class="sk-line sk-line-2" x1="40" y1="51" x2="58" y2="51" stroke-width="1.6"></line>
    <line class="sk-line sk-line-3" x1="40" y1="58" x2="54" y2="58" stroke-width="1.6"></line>

    {/* the live stroke being drawn, in red pen */}
    <path
      class="sk-stroke"
      d="M 22 74 Q 34 66, 46 73 Q 56 79, 64 71"
      stroke="var(--color-red-ink)"
      stroke-width="2.2"
      pathLength="100"></path>

    {
      /* a proper yellow pencil; the translate lands the graphite tip exactly on
        the stroke's end point (64,71) so sk-pencil-trace can ride the curve */
    }
    <g class="sk-pencil">
      <g transform="translate(3.4 -3.7) rotate(42 64 71)">
        <rect x="59" y="38" width="10" height="28" rx="1.5" fill="var(--color-highlight)"></rect>
        <rect x="59" y="33" width="10" height="5" rx="1" fill="var(--color-red-stamp)" stroke="none"
        ></rect>
        <line x1="59" y1="60" x2="69" y2="60" stroke-width="1.6"></line>
        <path d="M 59 66 L 64 76 L 69 66 Z" fill="var(--color-paper-warm)"></path>
        <path d="M 61.5 70 L 64 76 L 66.5 70 Z" fill="var(--color-ink)" stroke="none"></path>
      </g>
    </g>
  </g>
</svg>
