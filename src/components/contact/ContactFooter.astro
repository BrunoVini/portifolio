---
import './ContactFooter.css';
import type { Locale } from '../../lib/types';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const year = new Date().getFullYear();

const lines =
  locale === 'pt'
    ? {
        ps: 'P.S.',
        body: 'Você chegou na última página do diário. Obrigado por ler.',
        sig: 'feito com',
        coffee: 'café',
        love: 'carinho',
        and: 'e',
        end: 'FIM',
        signoff: '— Bruno, ' + year,
      }
    : {
        ps: 'P.S.',
        body: 'You reached the last page of the diary. Thanks for reading.',
        sig: 'made with',
        coffee: 'coffee',
        love: 'love',
        and: 'and',
        end: 'THE END',
        signoff: '— Bruno, ' + year,
      };
---

<div class="cf" data-reveal>
  <div class="cf-divider" aria-hidden="true">
    <svg viewBox="0 0 600 24" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <line
        x1="0"
        y1="12"
        x2="600"
        y2="12"
        stroke="var(--color-margin-red)"
        stroke-width="1.5"
        stroke-dasharray="6 4"></line>
    </svg>
    <span class="cf-divider-icon" aria-hidden="true">★</span>
  </div>

  <div class="cf-row">
    <div class="cf-bruno" aria-hidden="true">
      <svg viewBox="0 0 110 130" xmlns="http://www.w3.org/2000/svg">
        <g
          stroke="var(--color-ink)"
          fill="none"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          {/* tail — swishes */}
          <path class="cat-tail" d="M 74 110 Q 100 108, 98 84 Q 97 70, 86 72" stroke-width="2.6"
          ></path>
          {/* sitting body */}
          <path d="M 36 122 Q 30 74, 55 68 Q 80 74, 74 122 Z" fill="var(--color-paper)"></path>
          <path d="M 44 122 Q 55 128, 66 122" stroke-width="1.6" opacity="0.5"></path>
          {/* head */}
          <circle cx="55" cy="42" r="23" fill="var(--color-paper)"></circle>
          {/* ears */}
          <path d="M 38 24 L 33 6 L 53 19 Z" fill="var(--color-paper)"></path>
          <path d="M 72 24 L 77 6 L 57 19 Z" fill="var(--color-paper)"></path>
          <path
            d="M 40 21 L 37 10 L 48 18 Z"
            fill="var(--color-red-ink)"
            fill-opacity="0.7"
            stroke="none"></path>
          <path
            d="M 70 21 L 73 10 L 62 18 Z"
            fill="var(--color-red-ink)"
            fill-opacity="0.7"
            stroke="none"></path>
          {/* eyes — blink */}
          <g class="cat-eyes">
            <circle cx="46" cy="41" r="2.6" fill="var(--color-ink)" stroke="none"></circle>
            <circle cx="64" cy="41" r="2.6" fill="var(--color-ink)" stroke="none"></circle>
          </g>
          {/* nose + mouth */}
          <path d="M 52 48 L 58 48 L 55 52 Z" fill="var(--color-red-ink)" stroke="none"></path>
          <path d="M 55 52 Q 55 57, 50 57 M 55 52 Q 55 57, 60 57" stroke-width="1.8"></path>
          {/* whiskers */}
          <path d="M 27 44 L 43 46 M 27 51 L 43 49" stroke-width="1.4" opacity="0.55"></path>
          <path d="M 83 44 L 67 46 M 83 51 L 67 49" stroke-width="1.4" opacity="0.55"></path>
          {/* front paws */}
          <ellipse cx="47" cy="122" rx="7" ry="5" fill="var(--color-paper)"></ellipse>
          <ellipse cx="64" cy="122" rx="7" ry="5" fill="var(--color-paper)"></ellipse>
          {/* raised waving paw */}
          <g class="cf-arm">
            <path d="M 42 92 Q 26 86, 22 64" stroke="var(--color-red-ink)" stroke-width="2.6"
            ></path>
            <circle cx="22" cy="60" r="5" fill="var(--color-paper)" stroke="var(--color-red-ink)"
            ></circle>
          </g>
        </g>
      </svg>
      <span class="cf-bye">{locale === 'pt' ? 'tchau!' : 'bye!'}</span>
    </div>

    <div class="cf-center">
      <p class="cf-ps">
        <strong>{lines.ps}</strong>
        {lines.body}
      </p>
      <p class="cf-made">
        {lines.sig}
        <span class="cf-icon" aria-label={lines.coffee}>☕</span>
        {lines.and}
        <span class="cf-icon cf-icon-red" aria-label={lines.love}>♥</span>
        {locale === 'pt' ? 'em' : 'in'}
        {year}.
      </p>
      <p class="cf-sign">{lines.signoff}</p>
    </div>

    <div class="cf-end" aria-hidden="true">
      <span>{lines.end}</span>
    </div>
  </div>

  <div class="cf-tape cf-tape-l" aria-hidden="true"></div>
  <div class="cf-tape cf-tape-r" aria-hidden="true"></div>
</div>
